# Ambiente Python e caches
**/.venv/
**/__pycache__/
*.pyc

# Arquivos intermediários (recriados pela ferramenta)
**/3-Projetos e intermediários/*/trabalho/

# Vídeos brutos e exportados não vão para o git (exceto o teste pequeno)
Edição com IA/1-Material bruto/*
!Edição com IA/1-Material bruto/teste-consul-sindico.mp4
Edição com IA/4-Vídeos exportados/*
!Edição com IA/4-Vídeos exportados/teste-consul-*

# Vídeos de referência não vão para o git (só as folhas de quadros e o resumo)
Edição com IA/2-Identidade visual e referências/referencias/*
!Edição com IA/2-Identidade visual e referências/referencias/*.jpg
!Edição com IA/2-Identidade visual e referências/referencias/*.txt

# Vídeos de apoio, imagens e ícones do usuário (ficam só no computador)
Edição com IA/2-Identidade visual e referências/videos-apoio/*
!Edição com IA/2-Identidade visual e referências/videos-apoio/clipe-de-teste.mp4
Edição com IA/2-Identidade visual e referências/imagens/*
!Edição com IA/2-Identidade visual e referências/imagens/.gitkeep

# Versões guardadas dos projetos (desfazer/histórico)
**/3-Projetos e intermediários/*/versoes/
